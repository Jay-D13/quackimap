<launch>
  <arg name="pkg_name"  default="map" doc="name of the package"/>
  <arg name="node_name" default="lightweight_map_slam_node" doc="name of the node"/>
  <arg name="veh" doc="Name of vehicle. ex: megaman"/>

  <group ns="$(arg veh)">
    <node pkg="$(arg pkg_name)" type="$(arg node_name).py" name="$(arg node_name)" output="screen" required="true">
      <param name="veh" value="$(arg veh)" />
      <param name="image_topic" value="camera_node/image/compressed" />
      <param name="odom_topic"  value="encoder_pose_node/odom" />
      <param name="camera_info_topic" value="camera_node/camera_info" />
      <param name="tag_size" value="0.065" />
      
      <!-- Jetson Nano Optimizations -->
      <param name="window_size" value="50" />  <!-- Max poses in sliding window -->
      <param name="keyframe_distance" value="0.15" />  <!-- meters between keyframes -->
      <param name="keyframe_angle" value="15.0" />  <!-- degrees between keyframes -->
      <param name="optimization_rate" value="0.5" />  <!-- Hz (2 seconds between optimizations) -->
      <param name="image_decimation" value="2" />  <!-- Downsample images 2x for faster processing -->
      <param name="publish_debug_image" value="false" />  <!-- Disable to save bandwidth -->
    </node>
  </group>
</launch>
