<launch>
    <arg name="pkg_name" value="gt_pose_visualizer"/>
    <arg name="node_name" value="gt_pose_visualizer_node"/>
    <arg name="required" default="false"/>

    <group ns="$(arg veh)">
        <node pkg="$(arg pkg_name)" name="$(arg pkg_name)" type="$(arg node_name).py" output="screen" required="$(arg required)">
            <param name="veh" value="$(arg veh)" />
        </node>
    </group>
</launch>
